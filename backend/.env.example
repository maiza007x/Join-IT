PORT=5000
NODE_ENV=development

# Required: secret for signing JWT (use a long random string)
SECRET_ACCESS_TOKEN=
# Required: shared secret with Order-IT (PHP) webhook, header X-Webhook-Secret
WEBHOOK_SECRET=

CONNECTSQL=localhost
PORTSQL=3306
USERSQL=
PASSWORDSQL=
# Required: database name of Join-IT
DBSQL=join_it
# Required: database name of Order-IT (dev: orderit_2, production: orderit)
DBSQL_ORDER=orderit_2
